---
import type { HTMLAttributes } from "astro/types";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Img from "@/components/Media/Img.astro";
import ContentReasonList, {
  type ReasonItem,
} from "@/components/Site/ContentReasonList.astro";
import threeLeaves from "@/assets/Images/pngs/3-leaves.png";
import fiveLeaves from "@/assets/Images/pngs/5-leaves.png";

type ImageSource = ImageMetadata | string;

type Props = HTMLAttributes<"section"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  eyebrow?: string;
  heading?: string;
  text?: string;
  /** The points to list. Renders nothing when empty. */
  items: ReasonItem[];
  /** An imported asset, a remote `http(s)` URL, or a path to a file in `public/`. */
  image: ImageSource;
  /** Leave unset on decorative images — renders `alt=""`. */
  imageAlt?: string;
  /** Decorative leaf graphic in the section's top-left corner. */
  topLeafImage?: ImageSource;
  /** Decorative leaf graphic in the section's bottom-right corner. */
  bottomLeafImage?: ImageSource;
};

const {
  render = true,
  eyebrow,
  heading = "Why Farrelly Bros?",
  text,
  items,
  image,
  imageAlt,
  topLeafImage = threeLeaves,
  bottomLeafImage = fiveLeaves,
  class: className,
  ...rest
} = Astro.props;
---

{
  render && (
    <Section
      theme="dark"
      paddingTop="large"
      paddingBottom="large"
      class:list={["why-us_section", className]}
      {...rest}
    >
      <Fragment slot="background">
        <div class="why-us_leaves" aria-hidden="true">
          <Img
            src={topLeafImage}
            alt=""
            transparent
            class="why-us_leaf top"
          />
          <Img
            src={bottomLeafImage}
            alt=""
            transparent
            class="why-us_leaf bottom"
          />
        </div>
      </Fragment>
      <ContentWrapper variant="columns">
        {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
        <Heading tag="h2" variant="h2" maxWidth={16}>
          {heading}
        </Heading>
        {text && <Paragraph maxWidth={40}>{text}</Paragraph>}
        <ContentReasonList items={items} />
        <Img
          slot="column2"
          src={image}
          alt={imageAlt}
          class="ratio-5-4 radius-large"
        />
      </ContentWrapper>
    </Section>
  )
}

<style is:global>
  @layer components {
    .why-us_section {
      background-color: var(--forest-600);
    }

    .why-us_leaves {
      position: absolute;
      inset: 0;
      overflow: clip;
      pointer-events: none;
    }

    /* The source PNGs already carry their own very low, baked-in opacity —
       see docs/DECISIONS.md — so no extra opacity or colour treatment is
       applied here, just position and size. */
    .why-us_leaf {
      --_size: 22rem;
      position: absolute;
      width: var(--_size);
      height: auto;

      /* Flush to the corner, not bled past it — `.why-us_leaves` clips to
         the section's own bounds, so any negative offset here crops the
         graphic rather than letting it overflow. */
      &.top {
        top: 0;
        left: 0;
      }

      &.bottom {
        bottom: 0;
        right: 0;
        rotate: 180deg;
      }
    }
  }
</style>
