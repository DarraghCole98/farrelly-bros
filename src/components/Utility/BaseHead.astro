---
import { getImage } from "astro:assets";
import {
  SITE_NAME,
  SITE_DESCRIPTION,
  SITE_CONTACT,
  GOOGLE_SITE_VERIFICATION,
} from "@/consts.ts";
import { isNoindexRoute } from "@/utils/seo.ts";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;

const {
  title,
  description = SITE_DESCRIPTION,
  image = "/og-image.jpg",
  type = "website",
  noindex,
} = Astro.props;

const isNoindex = noindex ?? isNoindexRoute(Astro.url.pathname);

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
/** The size every major platform renders a large share card at. */
const SHARE_WIDTH = 1200;
const SHARE_HEIGHT = 630;

/* An imported asset is cropped to the share-card shape and served as JPEG,
   since not every platform renders WebP or AVIF previews. A string path is
   the author's own file, so it is left untouched. */
const shareImage =
  typeof image === "string"
    ? undefined
    : await getImage({
        src: image,
        width: SHARE_WIDTH,
        height: SHARE_HEIGHT,
        fit: "cover",
        format: "jpg",
      });

const socialImage = new URL(shareImage?.src ?? (image as string), Astro.site);

/**
 * LocalBusiness structured data, emitted site-wide. SITE_CONTACT.email and
 * SITE_URL (astro.config.mjs `site`) are both still flagged as unverified
 * placeholders in consts.ts — confirm both before this is relied on for SEO,
 * since it makes them machine-readable and publicly indexed.
 */
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: SITE_NAME,
  url: Astro.site ? new URL("/", Astro.site).toString() : undefined,
  telephone: SITE_CONTACT.phone,
  email: SITE_CONTACT.email,
  address: SITE_CONTACT.address
    ? { "@type": "PostalAddress", streetAddress: SITE_CONTACT.address }
    : undefined,
};
---

<meta charset="utf-8" />
<style is:inline>
  @layer base, patterns, components, utilities;
</style>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="preconnect" href="https://use.typekit.net" crossorigin />
<link rel="preconnect" href="https://p.typekit.net" crossorigin />
<link rel="stylesheet" href="https://use.typekit.net/cbc6nnx.css" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{isNoindex && <meta name="robots" content="noindex, nofollow" />}
{
  GOOGLE_SITE_VERIFICATION && (
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
  )
}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
{
  shareImage && (
    <>
      <meta property="og:image:width" content={String(SHARE_WIDTH)} />
      <meta property="og:image:height" content={String(SHARE_HEIGHT)} />
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
