---
import Layout from "@/layouts/BaseLayout.astro";
import SectionHeroMedia from "@/components/Site/SectionHeroMedia.astro";
import Section from "@/components/Wrapper/Section.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import ContentFeatureRow from "@/components/Site/ContentFeatureRow.astro";
import Breadcrumbs from "@/components/Site/Breadcrumbs.astro";
import ProjectEnquiryForm from "@/components/Enquiry/ProjectEnquiryForm.astro";
import { SITE_CONTACT } from "@/consts.ts";
import heroImage from "@/assets/Images/farrelly-brothers-herro5.webp";
import iconPin from "@/assets/icons/pin.svg";
import iconWrench from "@/assets/icons/wrench.svg";
import iconCheck from "@/assets/icons/check.svg";

const WHAT_HAPPENS = [
  {
    title: "Tell us about the site.",
    text: "Access, ground conditions and what is actually growing there shape the answer more than anything else.",
    icon: iconPin,
  },
  {
    title: "We work out the approach.",
    text: "What equipment the site will take, what order the work has to follow, and what it needs to be done safely.",
    icon: iconWrench,
  },
  {
    title: "You get a scoped quote.",
    text: "Priced against the work the site actually needs, not a standard rate applied to every job.",
    icon: iconCheck,
  },
];
---

<Layout
  title="Contact"
  description="Discuss a project with Farrelly Bros — specialist arboriculture, vegetation management, site clearance and land contracting."
>
  <SectionHeroMedia
    eyebrow="Contact"
    heading="Discuss a project."
    text="Tell us what the site needs and we will come back with how it would be approached, what equipment it calls for, and what it would cost."
    image={heroImage}
  />

  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Contact" }]} />

  <Section paddingTop="large" paddingBottom="large">
    <ProjectEnquiryForm />
  </Section>

  {
    SITE_CONTACT.address && (
      <Section paddingTop="none" paddingBottom="large">
        <div class="contact-map">
          <iframe
            src={`https://www.google.com/maps?q=${encodeURIComponent(SITE_CONTACT.address)}&output=embed`}
            title={`Map showing Farrelly Bros at ${SITE_CONTACT.address}`}
            loading="lazy"
          />
        </div>
      </Section>
    )
  }

  <Section paddingTop="large" paddingBottom="large" class="background-2">
    <Eyebrow>What happens next</Eyebrow>
    <Heading tag="h2" variant="h2" maxWidth={20}>
      How an enquiry gets answered.
    </Heading>
    <ContentFeatureRow items={WHAT_HAPPENS} />
  </Section>
</Layout>

<style is:global>
  @layer components {
    .contact-map {
      width: 100%;
      aspect-ratio: 21 / 9;
      overflow: clip;
      border-radius: var(--radius-large);

      & > iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
      }
    }
  }
</style>
