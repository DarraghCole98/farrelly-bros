---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/Media/Icon.astro";
import check from "@/assets/icons/check.svg";

interface Props extends HTMLAttributes<"ul"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The points being confirmed. Renders nothing when empty. */
  items: string[];
}

const { render = true, items, class: className, ...rest } = Astro.props;
---

{
  render && items.length > 0 && (
    <ul class:list={["checklist_wrap", className]} {...rest}>
      {items.map((item) => (
        <li class="checklist_item">
          <span class="checklist_marker">
            <Icon src={check} variant="small" />
          </span>
          <span class="checklist_text">{item}</span>
        </li>
      ))}
    </ul>
  )
}

<style is:global>
  @layer components {
    .checklist_wrap {
      /* Carries its own top margin the way .button-wrapper does, so it clears
         the leading trim of whatever text it follows. */
      margin-top: var(--space-6);
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      width: 100%;
    }

    .checklist_item {
      display: flex;
      align-items: flex-start;
      gap: var(--space-3);
    }

    /* A filled disc so the tick reads at small sizes, on light or dark. */
    .checklist_marker {
      flex: none;
      display: grid;
      place-items: center;
      width: 1.5em;
      height: 1.5em;
      margin-top: 0.05em;
      border-radius: var(--radius-round);
      background-color: var(--heading-accent);
      color: var(--background);

      & .icon {
        width: 0.75em;
        /* The shared tick is drawn hairline-thin; it needs weight here. */
        stroke-width: 0.1875rem;
      }
    }

    .checklist_text {
      color: var(--text-2);
    }
  }
</style>
