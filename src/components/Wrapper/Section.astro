---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";
import Img from "@/components/Media/Img.astro";
import Overlay from "@/components/Media/Overlay.astro";

type ImageSource = ImageMetadata | string;

type SectionSpace =
  "none" | "even" | "small" | "medium" | "large" | "navoverlap";

type ContainerGap =
  | "0"
  | "1"
  | "2"
  | "3"
  | "4"
  | "5"
  | "6"
  | "7"
  | "8"
  | "small"
  | "medium"
  | "large";

interface Props extends HTMLAttributes<"section"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Colors this section and everything inside it. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /**
   * Space above the content.
   *
   * - `medium` — the usual gap between sections (default)
   * - `none` — flush, for a section that meets the one above it
   * - `even` — the site margin, matching the space at the sides
   * - `small`, `large` — tighter or looser than usual
   * - `navoverlap` — clears a nav sitting over the page
   */
  paddingTop?: SectionSpace;
  /** Space below the content. Takes the same values as `paddingTop`. */
  paddingBottom?: SectionSpace;
  /** Space between the children, from the spacing scale. Defaults to `8`. */
  gap?: ContainerGap;
  /** Where the content sits across the section. Defaults to `start`. */
  align?: "start" | "center" | "end";
  /** Fills the screen's height, however little content there is. */
  fullHeight?: boolean;
  /** Classes for the container inside the section, which sets the width. */
  containerClass?: string;
  /** Attributes for that same container. */
  containerAttrs?: HTMLAttributes<"div">;
  /**
   * A photo behind the section, tinted so the content on top stays
   * readable. An imported asset, a remote `http(s)` URL, or a path to a
   * file in `public/`. For anything more custom — a second layer, a
   * gradient instead of a tint, eager loading on a hero — use the
   * `background` slot instead, which this defers to when both are given.
   */
  image?: ImageSource;
  /** Leave unset on decorative images — renders `alt=""`. */
  imageAlt?: string;
  /**
   * How dark the tint over `image` is, from 0 to 100. Defaults to 55,
   * matching every other photo section on the site.
   *
   * @min 0
   * @max 100
   * @int
   */
  overlayStrength?: number;
}

const {
  render = true,
  theme = "inherit",
  paddingTop = "medium",
  paddingBottom = "medium",
  gap = "8",
  align,
  fullHeight = false,
  containerClass,
  containerAttrs = {},
  image,
  imageAlt,
  overlayStrength = 55,
  class: className,
  ...rest
} = Astro.props;

const { class: containerAttrsClass, ...containerRest } = containerAttrs;

const padSuffix: Partial<Record<SectionSpace, string>> = {
  none: "0",
  even: "sitemargin",
};

const padClass = (side: "top" | "bottom", value: SectionSpace) =>
  !!value &&
  value !== "medium" &&
  `padding-${side}-${padSuffix[value] ?? value}`;

const content = await slotContent(Astro.slots);
const background = await slotContent(Astro.slots, "background");

if (import.meta.env.DEV && render && background && image) {
  console.warn(
    "[lumos] <Section> ignores `image` when a `background` slot is also given.",
  );
}
---

{
  render && (content || background || image) && (
    <section
      class:list={[
        "section",
        padClass("top", paddingTop),
        padClass("bottom", paddingBottom),
        fullHeight && "min-height-screen",
        theme !== "inherit" && `theme-${theme}`,
        align && `alignment-${align}`,
        className,
      ]}
      {...rest}
    >
      {background ? (
        <Fragment set:html={background} />
      ) : (
        image && (
          <>
            <Img src={image} alt={imageAlt} />
            <Overlay variant="solid" strength={overlayStrength} />
          </>
        )
      )}
      {content && (
        <div
          class:list={[
            "container",
            gap !== "8" && `gap-${gap}`,
            containerClass,
            containerAttrsClass,
          ]}
          {...containerRest}
        >
          <Fragment set:html={content} />
        </div>
      )}
    </section>
  )
}
