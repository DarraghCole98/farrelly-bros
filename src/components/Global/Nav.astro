---
import NavLink from "@/components/Global/NavLink.astro";
import NavUtility from "@/components/Global/NavUtility.astro";
import Icon from "@/components/Media/Icon.astro";
import Button from "@/components/Button.astro";
import logo from "@/assets/Images/farrelly-brothers-logo.svg";
import arrow from "@/assets/icons/arrow.svg";
import { SITE_NAME } from "@/consts.ts";
import { PRIMARY_NAV, SERVICE_LINKS } from "@/components/Global/navigation.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;

const onServicesPage = Astro.url.pathname.startsWith("/services");
const [homeLink, ...restLinks] = PRIMARY_NAV;
const beforeServices = [homeLink];
const afterServices = restLinks;
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <NavUtility />
      <div class="nav_bar">
       <div class="nav_inner">
        <a class="nav_logo" href="/" aria-label={SITE_NAME}>
          <img
            class="nav_logo_mark"
            src={logo.src}
            width={logo.width}
            height={logo.height}
            alt=""
          />
        </a>
        <div class="nav_controls">
          <Button element="link" href="/contact/" class="nav_cta_bar">
            Discuss a Project
          </Button>
          <button
            class="nav_toggle"
            type="button"
            aria-label="Menu"
            aria-expanded="false"
            aria-controls="nav-menu"
          >
            <span class="nav_toggle_icon" />
          </button>
        </div>
        <nav class="nav_menu" id="nav-menu" aria-label="Main">
          <div class="nav_menu_inner">
            <ul class="nav_links">
              {beforeServices.map((item) => (
                <NavLink href={item.href}>{item.label}</NavLink>
              ))}
              <li>
                <div
                  class:list={["dropdown_wrap", onServicesPage && "current"]}
                  data-nav-dropdown
                >
                  <div class="dropdown_control">
                    <a class="dropdown_toggle" href="/services/">
                      <span class="dropdown_label text-style-trim">
                        Services
                      </span>
                    </a>
                    <button
                      type="button"
                      class="dropdown_expand"
                      aria-expanded="false"
                      aria-controls="nav-services-menu"
                      aria-label="Show services menu"
                    >
                      <Icon class="dropdown_icon" src={arrow} variant="small" />
                    </button>
                  </div>
                  <div class="dropdown_content" id="nav-services-menu">
                    <div class="dropdown_body margin-trim">
                      <ul class="nav_dropdown_links">
                        <NavLink href="/services/">All Services</NavLink>
                        {SERVICE_LINKS.map((service) => (
                          <NavLink href={service.href}>{service.label}</NavLink>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              </li>
              {afterServices.map((item) => (
                <NavLink href={item.href}>{item.label}</NavLink>
              ))}
            </ul>
            <Button element="link" href="/contact/" class="nav_cta">
              Discuss a Project
            </Button>
          </div>
        </nav>
       </div>
      </div>
    </header>
  )
}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    window
      .matchMedia("(width >= 48rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
  }

  const servicesDropdown = nav?.querySelector<HTMLElement>(
    "[data-nav-dropdown]",
  );
  const servicesExpand =
    servicesDropdown?.querySelector<HTMLButtonElement>(".dropdown_expand");

  if (servicesDropdown && servicesExpand) {
    const setServicesOpen = (open: boolean) => {
      servicesDropdown.classList.toggle("open", open);
      servicesExpand.setAttribute("aria-expanded", String(open));
    };

    servicesExpand.addEventListener("click", () => {
      setServicesOpen(!servicesDropdown.classList.contains("open"));
    });

    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        servicesDropdown.classList.contains("open")
      ) {
        setServicesOpen(false);
        servicesExpand.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (
        !servicesDropdown.classList.contains("open") ||
        !(target instanceof Node)
      )
        return;
      if (!servicesDropdown.contains(target)) setServicesOpen(false);
    });

    window
      .matchMedia("(width >= 48rem)")
      .addEventListener("change", () => setServicesOpen(false));
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      background-color: var(--background-2);
      color: var(--text);

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav_bar {
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      padding-block: var(--space-3);
      border-bottom: var(--border-width) solid var(--border);
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--space-6);
    }

    /* Bar height */
    .nav_logo,
    .nav_toggle {
      min-height: var(--nav-height);
    }

    .nav_logo {
      display: flex;
      align-items: center;
      width: auto;

      /* A round badge, not a wordmark — height is what has to be held. */
      & .nav_logo_mark {
        display: block;
        width: auto;
        height: 6rem;
      }
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_controls {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .nav_cta_bar {
      padding: 0.6em 1em;
      font-size: var(--text-small);
    }

    .nav_toggle {
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      margin-right: calc((2.75rem - var(--_icon-width)) / -2);
      color: inherit;
      border-radius: var(--radius-small);
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background-2);
      border-bottom: var(--border-width) solid var(--border);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: var(--space-2) var(--site-margin) var(--space-4);
      font-size: var(--text-main);
      font-weight: var(--primary-semibold);
      & > li + li {
        border-top: var(--border-width) solid var(--border);
      }
    }

    .nav_link {
      display: block;
      padding-block: var(--space-3);
      color: color-mix(in lab, currentcolor 60%, transparent);
      text-decoration: none;
      text-underline-offset: 0.4em;
      text-decoration-thickness: var(--border-width);
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-current="page"] {
        color: var(--text);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    /* Services dropdown, matched to sit inside .nav_links like a NavLink.
       Built from plain markup rather than <Dropdown> so the label can be a
       real link (click navigates to /services/) while a separate control
       opens the flyout on hover, focus or tap. */
    .nav_menu .dropdown_wrap {
      position: relative;
      z-index: 10;
    }

    .nav_menu .dropdown_control {
      display: flex;
      align-items: center;
      gap: 0.5em;
    }

    .nav_menu .dropdown_toggle {
      flex: 1;
      display: flex;
      align-items: center;
      padding-block: var(--space-3);
      color: color-mix(in lab, currentcolor 60%, transparent);
      text-decoration: none;
      cursor: pointer;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    .nav_menu .dropdown_wrap.current .dropdown_toggle {
      color: var(--text);
    }

    .nav_menu .dropdown_expand {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-2);
      margin: calc(var(--space-2) * -1);
      color: inherit;
      border-radius: var(--radius-small);
      cursor: pointer;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_menu .dropdown_icon {
      --_size: 0.875em;
      flex: none;
      rotate: 90deg;
      transition: rotate var(--open-duration) var(--open-ease);
    }

    .nav_menu .dropdown_wrap:is(:hover, :focus-within, .open) .dropdown_icon {
      rotate: -90deg;
    }

    /* Mobile: expands in place rather than floating over the menu */
    .nav_menu .dropdown_content {
      display: none;
      position: static;
      width: auto;
      min-width: 0;
      max-width: none;
      background-color: transparent;
    }

    .nav_menu .dropdown_wrap.open .dropdown_content {
      display: block;
    }

    .nav_menu .dropdown_body {
      padding: 0 0 var(--space-2) var(--space-4);
    }

    .nav_dropdown_links {
      display: flex;
      flex-direction: column;
      & > li + li {
        border-top: var(--border-width) solid var(--border);
      }
    }

    .nav_cta {
      display: none;
    }

    @media (width >= 48rem) {
      .nav_controls {
        display: none;
      }

      .nav_toggle {
        display: none;
      }

      .nav_menu {
        position: static;
        display: block;
        visibility: visible;
        max-height: none;
        overflow: visible;
        background-color: transparent;
        border-bottom: 0;
      }

      .nav_menu_inner {
        overflow: visible;
        opacity: 1;
        display: flex;
        align-items: center;
        gap: var(--space-6);
      }

      .nav_links {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        padding: 0;
        gap: var(--space-5);
        font-size: var(--text-main);
        & > li + li {
          border-top: 0;
        }
      }

      .nav_link {
        padding-block: 0;
        &[aria-current="page"] {
          text-decoration: underline;
        }
      }

      .nav_menu .dropdown_toggle {
        padding-block: var(--_control-pad, 0.75em);
      }

      .nav_dropdown_links .nav_link {
        padding-block: var(--space-2);
      }

      /* Restore the floating flyout for the desktop dropdown — opens on
         hover, keyboard focus, or the expand control's tap-toggle. */
      .nav_menu .dropdown_content {
        display: block;
        position: absolute;
        top: calc(100% + var(--space-2));
        inset-inline-start: 0;
        opacity: 0;
        pointer-events: none;
        translate: 0 -0.5rem;
        scale: 0.98;
        width: max-content;
        min-width: 100%;
        max-width: min(22rem, calc(100vw - var(--site-margin) * 2));
        background-color: var(--background-2);
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-main);
        box-shadow: 0 1rem 2.5rem -1rem color-mix(in lab, var(--ink-900) 25%, transparent);
        transition:
          opacity var(--hover-duration) var(--hover-ease),
          translate var(--hover-duration) var(--hover-ease),
          scale var(--hover-duration) var(--hover-ease);
      }

      .nav_menu .dropdown_wrap:is(:hover, :focus-within, .open) .dropdown_content {
        opacity: 1;
        pointer-events: auto;
        translate: 0 0;
        scale: 1;
        transition:
          opacity var(--open-duration) var(--open-ease),
          translate var(--open-duration) var(--open-ease),
          scale var(--open-duration) var(--open-ease);
      }

      .nav_menu .dropdown_body {
        padding: var(--space-5);
      }

      .nav_cta {
        display: inline-flex;
      }
    }
  }
</style>
