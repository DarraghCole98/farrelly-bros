# Copy to .env for `astro dev`, and set the matching values in the
# Cloudflare Pages dashboard (Settings → Environment variables) for
# production/preview. See README-ENQUIRY.md for what each one does and
# what still works with it unset.

# Client-exposed (must keep the PUBLIC_ prefix). Leave unset to hide the
# Turnstile widget entirely rather than show a broken one.
PUBLIC_TURNSTILE_SITE_KEY=

# --- Cloudflare Pages Function env vars (server-only, never PUBLIC_) ---
# Set these in the Cloudflare dashboard, or in .dev.vars for local
# `wrangler pages dev` testing — never commit real values.

# Turnstile secret key (pairs with PUBLIC_TURNSTILE_SITE_KEY above).
TURNSTILE_SECRET_KEY=

# Resend — preferred email path. Both required together for the structured
# notification email and the customer acknowledgement email to send.
RESEND_API_KEY=
RESEND_FROM="Farrelly Bros Enquiries <enquiries@farrellybros.ie>"
NOTIFY_TO=

# Fallback notification path while Resend isn't configured — defaults to
# the same Web3Forms key already used by the classic contact form.
WEB3FORMS_ACCESS_KEY=

# HMAC secret for signed file-download links. Required for uploaded files
# to be linkable from the notification email — generate a long random
# string, e.g. `openssl rand -hex 32`.
FILES_SIGNING_SECRET=

# Absolute origin used to build links in the notification email. Falls back
# to the request's own origin if unset.
SITE_URL=
