---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/Media/Img.astro";
import contourLines from "@/assets/graphics/Footer-contour-lines-clip-path-group.svg";

type ImageSource = ImageMetadata | string;

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** A quieter opening line above the statement. Defaulted on the banner, and shown on the panel only when set. */
  lead?: string;
  /** The closing statement. */
  heading?: string;
  /** A short supporting line under the heading. */
  text?: string;
  /** Label of the primary button. */
  buttonLabel?: string;
  /** Where the primary button leads. */
  buttonHref?: string;
  /**
   * Opens `<Modal id={modalId}>` instead of following `buttonHref` — for a
   * quick enquiry in place, rather than leaving the page.
   */
  modalId?: string;
  /**
   * How the closing call to action sits on the page.
   *
   * - `banner` — a brand-green card, statement left and button right (default)
   * - `panel` — a quiet surface card, centred, for a call mid-page
   * - `centered` — a plain centred block, inheriting the section's theme
   */
  variant?: "banner" | "panel" | "centered";
  /** Pull the banner down so it sits half inside the footer. Banner only. */
  overlap?: boolean;
  /**
   * A photo behind the banner, tinted with the brand gradient so the
   * statement stays readable. Banner only. An imported asset, a remote
   * `http(s)` URL, or a path to a file in `public/`.
   */
  image?: ImageSource;
  /** Leave unset on decorative images — renders `alt=""`. */
  imageAlt?: string;
}

const {
  render = true,
  lead,
  heading = "Let's plan it properly.",
  text,
  buttonLabel = "Discuss a Project",
  buttonHref = "/contact/",
  variant = "banner",
  overlap = false,
  image,
  imageAlt,
  modalId,
  class: className,
  ...rest
} = Astro.props;

if (import.meta.env.DEV && variant === "centered" && overlap) {
  console.warn(
    "[farrelly] <ContentCtaMain> ignores overlap: it only applies to the banner variant.",
  );
}

if (import.meta.env.DEV && variant !== "banner" && image) {
  console.warn(
    "[farrelly] <ContentCtaMain> ignores image outside the banner variant.",
  );
}

const banner = variant === "banner";
const panel = variant === "panel";

/* The banner opens on a standing line; the panel stays quiet unless asked. */
const opening = lead ?? (banner ? "Have a challenging project?" : undefined);
---

{
  render && banner && (
    <>
      {overlap && (
        <div class="cta-main_graphic_band" aria-hidden="true">
          <Img src={contourLines} alt="" loading="eager" />
        </div>
      )}
      <div
        class:list={[
          "cta-main_wrap",
          "theme-brand",
          overlap && "overlap",
          image && "has-image",
          className,
        ]}
        {...rest}
      >
        {image && (
          <div class="cta-main_media">
            <Img src={image} alt={imageAlt} />
            <div class="cta-main_gradient" />
          </div>
        )}
        <div class="cta-main_statement">
          {opening && <p class="cta-main_lead text-style-h3">{opening}</p>}
          <Heading tag="h2" variant="h2" maxWidth={22}>
            {heading}
          </Heading>
          {text && (
            <Paragraph variant="large" maxWidth={40}>
              {text}
            </Paragraph>
          )}
        </div>
        <ButtonWrapper class="cta-main_action">
          {
            modalId ? (
              <Button type="button" data-modal-open={modalId}>
                {buttonLabel}
              </Button>
            ) : (
              <Button element="link" href={buttonHref}>
                {buttonLabel}
              </Button>
            )
          }
        </ButtonWrapper>
      </div>
    </>
  )
}

{
  render && panel && (
    <div class:list={["cta-main_panel", "alignment-center", className]} {...rest}>
      {opening && <p class="cta-main_lead text-style-h3">{opening}</p>}
      <Heading tag="h2" variant="h2" maxWidth={24}>
        {heading}
      </Heading>
      {text && (
        <Paragraph variant="main" maxWidth={44}>
          {text}
        </Paragraph>
      )}
      <ButtonWrapper>
        {
          modalId ? (
            <Button type="button" data-modal-open={modalId}>
              {buttonLabel}
            </Button>
          ) : (
            <Button element="link" href={buttonHref}>
              {buttonLabel}
            </Button>
          )
        }
      </ButtonWrapper>
    </div>
  )
}

{
  render && !banner && !panel && (
    <div class:list={["alignment-center", className]} {...rest}>
      <Heading tag="h2" variant="h2" maxWidth={20}>
        {heading}
      </Heading>
      {text && (
        <Paragraph variant="large" maxWidth={40}>
          {text}
        </Paragraph>
      )}
      <ButtonWrapper>
        {
          modalId ? (
            <Button type="button" data-modal-open={modalId}>
              {buttonLabel}
            </Button>
          ) : (
            <Button element="link" href={buttonHref}>
              {buttonLabel}
            </Button>
          )
        }
      </ButtonWrapper>
    </div>
  )
}

<style is:global>
  @layer components {
    /* The graphic's native size is 2560×1014 (viewBox `0 0 2560 1014`) — a
       wide, short banner, aspect ratio ~2.52:1. It must never be stretched
       or cover-cropped to fill this section's own (much taller, card-
       driven) height: `height: auto` + a matching `aspect-ratio` keep it
       at its true proportions, full width, nothing scaled up or cropped
       away. `object-position: top` anchors it to the top of the band
       rather than centering, so nothing is pushed off-screen. Full-bleed
       past this section's max-width container via the 100vw breakout.

       The viewBox is the artwork's original, uncropped framing — an
       earlier attempt trimmed off what looked like a blank top margin,
       but that made the visible portion start abruptly mid-shape, which
       read as a crop rather than an intentional edge. Showing the whole
       original composition, even with a quieter top few percent, looks
       like a real top edge instead.

       `--light-100` (plain white) fills whatever space below the artwork
       the band's own height doesn't need — matching the plain white
       background used elsewhere on the site, per direct request. Sits
       behind the card and the section's other content (z-index 0; the
       card is z-index 1 — see `.cta-main_wrap.overlap` below). */
    .cta-main_graphic_band {
      position: absolute;
      /* `inset: 0` alone would only span `.container`'s own box (it has
         `position: relative`, making it — not the full-width `.section`
         — the containing block here), so width uses the 100vw breakout
         instead to reach the true edges of the viewport. */
      top: 0;
      bottom: 0;
      left: 50%;
      width: 100vw;
      transform: translateX(-50%);
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
      background-color: var(--light-100);

      & .image {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 2560 / 1014;
        object-fit: contain;
        object-position: top;
      }
    }

    .cta-main_wrap {
      /* Overridable per-instance (e.g. from Stacki's style field on this
         component) to swap in a different tint or direction. */
      --_cta-gradient: linear-gradient(
        100deg,
        color-mix(in srgb, var(--brand-400) 96%, transparent) 20%,
        color-mix(in srgb, var(--brand-400) 40%, transparent) 100%
      );
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
      width: 100%;
      padding: var(--section-space-small) var(--space-8);
      border-radius: var(--radius-large);
      overflow: clip;

      @media (width >= 48rem) {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-7);
        padding-inline: var(--section-space-small);
      }
    }

    .cta-main_media {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;

      & > .image {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    .cta-main_gradient {
      position: absolute;
      inset: 0;
      background-image: var(--_cta-gradient);
    }

    .cta-main_statement,
    .cta-main_action {
      .has-image & {
        position: relative;
        z-index: 1;
      }
    }

    .cta-main_statement {
      display: flex;
      flex-direction: column;
    }

    /* The quieter opening line, matched to the heading's size but not its weight. */
    .cta-main_lead {
      font-weight: var(--primary-regular);
    }

    .cta-main_action {
      flex-shrink: 0;
    }

    /* A quieter card than the banner, for a call that sits mid-page. */
    .cta-main_panel {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-4);
      width: 100%;
      padding: var(--section-space-small) var(--space-8);
      background-color: var(--background-2);
      border-radius: var(--radius-large);
    }

    /* Overlapping the footer: the banner lifts itself over the seam, and the
       footer opens up enough top padding to receive it. The margin-top
       sets how tall the section — and so the graphic band behind it, which
       matches the section's own height exactly (`bottom: 0` in
       `.cta-main_graphic_band`) so it always meets the footer with no gap
       — ends up.

       Kept deliberately small relative to the image's own height (~39.6vw
       at aspect ratio 2560/1014) so the card starts well before the image
       ends, overlapping it by a wide margin rather than lining up close to
       its bottom edge — a close-to-exact match risked a sliver of the
       band's own background showing between them. The section still ends
       up tall enough to clear the image overall once the card's own
       height is added on top of this margin. */
    .cta-main_wrap.overlap {
      position: relative;
      z-index: 1;
      margin-top: min(27vw, 22rem);
      margin-bottom: calc(var(--section-space-small) * -1);
    }

    body:has(.cta-main_wrap.overlap) .footer_wrap {
      --_lift: var(--section-space-small);
    }
  }
</style>
