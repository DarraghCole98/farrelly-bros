---
import {
  SITE_NAME,
  SITE_CONTACT,
  SITE_SOCIAL,
  GOOGLE_ANALYTICS_ID,
} from "@/consts.ts";
import {
  FOOTER_NAV,
  SERVICE_LINKS,
} from "@/components/Global/navigation.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;

const hasContact = Object.values(SITE_CONTACT).some(Boolean);
const hasSocial = SITE_SOCIAL.length > 0;
const hasAnalytics = GOOGLE_ANALYTICS_ID.length > 0;
---

{
  render && (
    <footer class="footer_wrap theme-dark">
      <div class="footer_inner">
        <div class="footer_top">
          <nav class="footer_nav" aria-label="Footer">
            <p class="footer_heading text-style-small">Navigation</p>
            <ul class="footer_links">
              {FOOTER_NAV.map((item) => (
                <li>
                  <a class="footer_link" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <nav class="footer_nav" aria-label="Services">
            <p class="footer_heading text-style-small">Services</p>
            <ul class="footer_links">
              {SERVICE_LINKS.map((service) => (
                <li>
                  <a class="footer_link" href={service.href}>
                    {service.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          {hasSocial && (
            <nav class="footer_nav" aria-label="Social">
              <p class="footer_heading text-style-small">Follow</p>
              <ul class="footer_links">
                {SITE_SOCIAL.map((social) => (
                  <li>
                    <a class="footer_link" href={social.href}>
                      {social.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          {hasContact && (
            <div class="footer_nav">
              <p class="footer_heading text-style-small">Contact</p>
              <ul class="footer_contact">
                {SITE_CONTACT.phone && (
                  <li>
                    <a
                      class="footer_contact_link"
                      href={`tel:${SITE_CONTACT.phone}`}
                    >
                      {SITE_CONTACT.phone}
                    </a>
                  </li>
                )}
                {SITE_CONTACT.mobile && (
                  <li>
                    <a
                      class="footer_contact_link"
                      href={`tel:${SITE_CONTACT.mobile}`}
                    >
                      {SITE_CONTACT.mobile} (Emergency)
                    </a>
                  </li>
                )}
                {SITE_CONTACT.email && (
                  <li>
                    <a
                      class="footer_contact_link"
                      href={`mailto:${SITE_CONTACT.email}`}
                    >
                      {SITE_CONTACT.email}
                    </a>
                  </li>
                )}
                {SITE_CONTACT.address && (
                  <li class="footer_contact_text">{SITE_CONTACT.address}</li>
                )}
              </ul>
            </div>
          )}
        </div>

        <div class="footer_bottom">
          <p class="footer_copyright text-style-small">
            &copy; <span id="year">{new Date().getFullYear()}</span>&#160;
            {SITE_NAME}
          </p>
          <div class="footer_legal_links">
            <a class="footer_legal_link text-style-small" href="/privacy-policy/">
              Privacy Policy
            </a>
            {hasAnalytics && (
              <button
                type="button"
                id="cookie-preferences"
                class="footer_legal_link footer_legal_button text-style-small"
              >
                Cookie Preferences
              </button>
            )}
          </div>
        </div>
      </div>
    </footer>
  )
}

<script>
  const year = document.querySelector<HTMLSpanElement>("#year");

  if (year) {
    year.textContent = new Date().getFullYear().toString();
  }

  document
    .getElementById("cookie-preferences")
    ?.addEventListener("click", () => {
      window.dispatchEvent(new Event("cookie-consent:reopen"));
    });
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      /* --_lift is set by an overlapping CTA banner, which pulls itself up
         into this padding rather than the footer reaching out for it. */
      --_lift: 0rem;
      position: relative;
      display: flex;
      justify-content: center;
      padding-block: calc(var(--section-space-medium) + var(--_lift))
        var(--section-space-small);
      padding-inline: var(--site-margin);
      /* Flat colour, no graphic — confirmed against the Figma source: the
         footer frame is `bg-[#305036]` with no image layer at all. The
         contour artwork lives in the CTA band above it instead (see
         `.cta-main_graphic_band` in ContentCtaMain.astro), matched to this
         same colour so the two meet with no seam. */
      background-color: var(--forest-600);
      color: var(--text);
      overflow: hidden;

      /* Reserves room for BaseLayout's fixed MobileCta bar, so its content
         isn't the last thing that bar covers. */
      @media (width < 48rem) {
        padding-bottom: calc(var(--section-space-small) + 4.5rem);
      }
    }

    .footer_inner {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    .footer_top {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-6) var(--site-gutter);
    }

    .footer_nav {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      flex: 1 1 10rem;
    }

    .footer_contact {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      font-size: var(--text-main);
      font-weight: var(--primary-semibold);
      color: var(--text);
    }

    .footer_contact_link {
      color: var(--brand-accent);
      text-underline-offset: 0.3em;
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    .footer_heading {
      color: var(--text-2);
      font-weight: var(--primary-semibold);
    }

    .footer_links {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      font-size: var(--text-main);
      font-weight: var(--primary-semibold);
    }

    .footer_link {
      color: var(--text);
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--brand-accent);
        }
      }
    }

    .footer_bottom {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2) var(--space-4);
      padding-top: var(--space-4);
      border-top: var(--border-width) solid var(--border);
    }

    .footer_copyright {
      color: var(--text-2);
    }

    .footer_legal_links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2) var(--space-4);
    }

    .footer_legal_link {
      color: var(--text-2);
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    .footer_legal_button {
      padding: 0;
      background: none;
      border: 0;
      font: inherit;
      cursor: pointer;
    }
  }
</style>
