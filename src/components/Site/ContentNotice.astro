---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** What the notice is about, set above the body. */
  heading?: string;
  /**
   * How much attention the notice asks for.
   *
   * - `standing` — a neutral aside, for context that is simply worth saying (default)
   * - `pending` — something is unfinished or unavailable, and reads that way
   */
  variant?: "standing" | "pending";
}

const {
  render = true,
  heading,
  variant = "standing",
  class: className,
  ...rest
} = Astro.props;

const body = await slotContent(Astro.slots);
---

{
  render && body && (
    <div
      class:list={["notice_wrap", variant !== "standing" && variant, className]}
      {...rest}
    >
      {heading && <p class="notice_heading text-style-small">{heading}</p>}
      <div class="notice_body text-style-small">
        <Fragment set:html={body} />
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .notice_wrap {
      --_marker: var(--border);
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      width: 100%;
      padding: var(--space-4);
      border: var(--border-width) solid var(--border);
      border-left: 0.1875rem solid var(--_marker);
      border-radius: var(--radius-small);
      background-color: var(--background-2);

      &.pending {
        --_marker: var(--heading-accent);
      }
    }

    .notice_heading {
      font-weight: var(--primary-semibold);
    }

    .notice_body {
      color: var(--text-2);

      /* Authored copy, so it can carry more than one paragraph. */
      & > * + * {
        margin-top: var(--space-2);
      }
    }
  }
</style>
