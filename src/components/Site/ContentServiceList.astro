---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Icon from "@/components/Media/Icon.astro";
import arrow from "@/assets/icons/arrow.svg";

interface ServiceListItem {
  title: string;
  summary: string;
  href: string;
}

interface Props extends HTMLAttributes<"ul"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The services to list, in order. */
  items: ServiceListItem[];
}

const { render = true, items, class: className, ...rest } = Astro.props;
---

{
  render && items.length > 0 && (
    <ul class:list={["service-list_wrap", className]} {...rest}>
      {items.map((item, index) => (
        <li>
          <a class="service-list_row" href={item.href}>
            <span class="service-list_index text-style-h4" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="service-list_body">
              <Heading tag="h3" variant="h4" class="service-list_title">
                {item.title}
              </Heading>
              <Paragraph variant="main" class="service-list_summary">
                {item.summary}
              </Paragraph>
            </span>
            <Icon
              class="service-list_arrow"
              src={arrow}
              variant="medium"
              aria-hidden="true"
            />
          </a>
        </li>
      ))}
    </ul>
  )
}

<style is:global>
  @layer components {
    .service-list_wrap {
      display: flex;
      flex-direction: column;
      & > li {
        border-top: var(--border-width) solid var(--border);
      }
      & > li:last-child {
        border-bottom: var(--border-width) solid var(--border);
      }
    }

    .service-list_row {
      display: flex;
      align-items: center;
      gap: var(--space-5);
      padding-block: var(--space-6);
      color: inherit;
      text-decoration: none;
      transition: gap var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          gap: var(--space-6);
          .service-list_arrow {
            translate: 0.25em 0;
          }
        }
      }
    }

    .service-list_index {
      flex: none;
      width: 3ch;
      color: var(--text-2);
    }

    .service-list_body {
      flex-grow: 1;
      min-width: 0;
    }

    .service-list_title {
      margin: 0;
    }

    .service-list_summary {
      margin-top: var(--space-1);
      color: var(--text-2);
    }

    .service-list_arrow {
      flex: none;
      transition: translate var(--hover-duration) var(--hover-ease);
    }

    @media (width < 48rem) {
      .service-list_index {
        display: none;
      }
    }
  }
</style>
