---
/**
 * "Step X of 5" plus a progress line. Driven entirely by the client script
 * afterwards — the markup here is just Step 1's resting state, rendered so
 * the page isn't blank before JS runs.
 */
import { TOTAL_STEPS } from "@/lib/enquiry/types.ts";

const STEP_LABELS = [
  "The Work",
  "The Site",
  "Access & Conditions",
  "Timing & Files",
  "Your Details",
];
---

<div class="enquiry-progress" data-enquiry-progress>
  <div class="enquiry-progress_text">
    <span class="text-style-small" data-enquiry-progress-label>
      Step 1 of {TOTAL_STEPS}
    </span>
    <span class="enquiry-progress_step-name text-style-small" data-enquiry-progress-step-name>
      {STEP_LABELS[0]}
    </span>
  </div>
  <div class="enquiry-progress_track" role="progressbar" aria-label="Enquiry progress" aria-valuemin="1" aria-valuemax={TOTAL_STEPS} aria-valuenow="1" data-enquiry-progress-track>
    <div class="enquiry-progress_fill" data-enquiry-progress-fill></div>
  </div>
</div>

<style is:global>
  @layer components {
    .enquiry-progress {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      width: 100%;
    }

    .enquiry-progress_text {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-3);
      color: var(--text-2);
    }

    .enquiry-progress_step-name {
      color: var(--text);
    }

    .enquiry-progress_track {
      position: relative;
      width: 100%;
      height: 0.1875rem;
      background-color: var(--border);
      border-radius: var(--radius-round);
      overflow: clip;
    }

    .enquiry-progress_fill {
      width: 20%;
      height: 100%;
      background-color: var(--text);
      transition: width var(--hover-duration) var(--hover-ease);

      @media (prefers-reduced-motion: reduce) {
        transition: none;
      }
    }
  }
</style>
