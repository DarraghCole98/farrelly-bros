---
import ContentSectionHeader from "@/components/Site/ContentSectionHeader.astro";
import ContentSectorGrid from "@/components/Site/ContentSectorGrid.astro";
import ContentClientMarquee from "@/components/Site/ContentClientMarquee.astro";
import { SECTORS } from "@/data/sectors.ts";

const items = SECTORS.map((sector) => ({
  label: sector.label,
  image: sector.image,
  imageAlt: sector.imageAlt,
  icon: sector.icon,
  href: `/sectors/${sector.slug}/`,
}));

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  eyebrow?: string;
  heading?: string;
  text?: string;
  /** Heading size. Matches `ContentSectionHeader`'s scale. */
  variant?: "h1" | "h2" | "h3";
  /** Shows a placeholder logo strip below the sector grid. */
  trustedBy?: boolean;
}

const {
  render = true,
  eyebrow = "Sectors",
  heading = "Where the work takes us.",
  text,
  variant = "h3",
  trustedBy = true,
} = Astro.props;
---

{
  render && (
    <Fragment>
      <ContentSectionHeader
        eyebrow={eyebrow}
        heading={heading}
        text={text}
        variant={variant}
      />
      <ContentSectorGrid items={items} />
      <ContentClientMarquee render={trustedBy} />
    </Fragment>
  )
}
